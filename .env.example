# ---- LLM provider (discovery runs only; replay never calls a model) ----
# Provider: "openai_compat" (NVIDIA NIM or any OpenAI-compatible endpoint) or "anthropic"
LLM_PROVIDER=openai_compat
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA NIM key (free tier). Used when LLM_PROVIDER=openai_compat
NVIDIA_API_KEY=

# Anthropic key. Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Mock legacy app ----
MOCK_APP_HOST=127.0.0.1
MOCK_APP_PORT=8000
# Demo operator credentials for the mock app (fake; never real).
# The automation reads these via secret references, never stores them in artifacts.
MOCK_APP_USERNAME=teller01
MOCK_APP_PASSWORD=Pa55word!
# Idle session timeout in seconds (0 disables the timer; chaos can still force expiry)
MOCK_APP_SESSION_IDLE_SECONDS=0

# ---- Operator console (human handoff) ----
OPERATOR_CONSOLE_PORT=8001
